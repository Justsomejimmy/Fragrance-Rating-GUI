import { HorizontalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component CategoryChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;

    callback selected_requested();

    height: 36px;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.accent : Theme.bg-card-alt;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.border;

    TouchArea {
        clicked => {
            root.selected_requested();
        }
    }

    Text {
        text: root.label;
        color: root.selected ? white : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}