import { VerticalBox, HorizontalBox, Button } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component sidebar inherits Rectangle {
    callback add_requested();
    callback dashboard_requested();
    callback collection_requested();
    callback settings_requested();
    callback rankings_requested();
    callback wishlist_requested();

    in-out property <bool> collapsed: false;

    width: root.collapsed ? 0px : 280px;
    background: Theme.bg-sidebar;
    clip: true;

    animate width {
        duration: 200ms;
        easing: ease-in-out-sine;
    }

    VerticalBox {
        padding: 20px;
        spacing: 15px;

        HorizontalBox {
            spacing: 8px;

            Text {
                text: "Fragrance Vault";
                font-size: 20px;
                font-weight: 800;
                color: Theme.text-primary;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            TouchArea {
                width: 50px;
                height: 50px;

                clicked => {
                    root.collapsed = true;
                }

                Text {
                    text: "«";
                    color: Theme.text-secondary;
                    font-size: 20px;
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 10px;
        }

        Button {
            text: "🏠 Dashboard";

            clicked => {
                root.dashboard_requested();
            }
        }

        Button {
            text: "📚 Collection";

            clicked => {
                root.collection_requested();
            }
        }

        Button {
            text: "⭐ Rankings";

            clicked => {
                root.rankings_requested();
            }
        }

        Button {
            text: "❤️ Wishlist";

            clicked => {
                root.wishlist_requested();
            }
        }

        Button {
            text: "➕ Add Fragrance";

            clicked => {
                root.add_requested();
            }
        }

        Button {
            text: "⚙ Settings";

            clicked => {
                root.settings_requested();
            }
        }
    }
}