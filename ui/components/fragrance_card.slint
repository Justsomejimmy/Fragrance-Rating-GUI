import { VerticalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component FragranceCard inherits Rectangle {
    in property <string> brand;
    in property <string> name;
    in property <float> rating;
    in property <string> notes;
    in property <string> seasons;
    in property <string> category;
    in property <image> fragrance-image;
    in property <float> image_offset_x;
    in property <float> image_offset_y;
    in property <float> image_scale: 1.0;

    callback card_clicked();

    width: 220px;
    height: 320px;

    background: Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;

    TouchArea {
        clicked => {
            root.card_clicked();
        }
    }

    VerticalBox {
        padding: Theme.space-sm;
        spacing: Theme.space-xs;

        Rectangle {
            height: 150px;
            border-radius: Theme.radius-sm;
            clip: true;
            background: #000000;

            Image {
                source: root.fragrance-image;
                width: parent.width * root.image_scale;
                height: parent.height * root.image_scale;
                x: (parent.width - self.width) / 2 + root.image_offset_x * 1px;
                y: (parent.height - self.height) / 2 + root.image_offset_y * 1px;
                image-fit: cover;
            }

            Rectangle {
                x: parent.width - self.width - 8px;
                y: 8px;
                width: 72px;
                height: 22px;
                background: #000000aa;
                border-radius: 11px;

                Text {
                    text: root.category;
                    color: white;
                    font-size: 11px;
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: root.brand;
            color: Theme.text-secondary;
            font-size: 12px;
        }

        Text {
            text: root.name;
            color: Theme.text-primary;
            font-size: 18px;
            font-weight: 700;
            wrap: word-wrap;
            overflow: elide;
        }

        Text {
            text: "⭐ " + root.rating;
            color: Theme.accent;
            font-size: 14px;
            font-weight: 600;
        }

        Text {
            text: root.notes;
            color: Theme.text-secondary;
            font-size: 12px;
            wrap: word-wrap;
            overflow: elide;
        }

        Text {
            text: root.seasons;
            color: Theme.text-muted;
            font-size: 12px;
        }
    }
}