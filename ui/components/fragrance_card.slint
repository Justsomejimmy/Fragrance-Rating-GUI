import { VerticalBox } from "std-widgets.slint";

export component FragranceCard inherits Rectangle {
    in property <string> brand;
    in property <string> name;
    in property <float> rating;
    in property <string> notes;
    in property <string> seasons;
    in property <image> fragrance-image;
    in property <float> image_offset_x;
    in property <float> image_offset_y;
    in property <float> image_scale: 1.0;

    callback card_clicked();

    width: 220px;
    height: 320px;

    background: #242424;
    border-radius: 12px;

    TouchArea {
        clicked => {
            root.card_clicked();
        }
    }

    VerticalBox {
        padding: 15px;
        spacing: 10px;

        Rectangle {
            width: 180px;
            height: 180px;
            clip: true;

            Image {
                source: root.fragrance-image;
                width: 180px * root.image_scale;
                height: 180px * root.image_scale;
                x: (180px - self.width) / 2 + root.image_offset_x * 1px;
                y: (180px - self.height) / 2 + root.image_offset_y * 1px;
                image-fit: contain;
            }
        }

        Text {
            text: brand + " - " + name;
            color: white;
            font-size: 18px;
            wrap: word-wrap;
        }

        Text {
            text: "⭐ " + rating;
            color: white;
        }

        Text {
            text: notes;
            color: #aaaaaa;
            wrap: word-wrap;
        }

        Text {
            text: seasons;
            color: #aaaaaa;
        }
    }
}