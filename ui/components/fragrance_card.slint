import { VerticalBox } from "std-widgets.slint";

export component FragranceCard inherits Rectangle {
    in property <string> brand;
    in property <string> name;
    in property <float> rating;
    in property <string> notes;
    in property <string> seasons;

    callback card_clicked();

    width: 220px;
    height: 320px;

    background: #242424;
    border-radius: 12px;
    
    TouchArea {
        clicked => {
            root.card_clicked();
        }
    }

    VerticalBox {

        padding: 15px;
        spacing: 10px;

        Rectangle {

            height: 150px;
            background: #333333;

            Text {
                text: "Bottle";
                color: #aaaaaa;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: brand + " - " + name;
            color: white;
            font-size: 18px;
            wrap: word-wrap;
        }

        Text {
            text: "⭐ " + rating;
            color: white;
        }

        Text {
            text: notes;
            color: #aaaaaa;
            wrap: word-wrap;
        }

        Text {
            text: seasons;
            color: #aaaaaa;
        }
    }
}