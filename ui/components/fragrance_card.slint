import { VerticalBox, HorizontalBox } from "std-widgets.slint";

export component FragranceCard inherits Rectangle {
    in property <string> brand;
    in property <string> name;
    in property <float> rating;
    in property <string> notes;
    in property <string> seasons;
    in property <string> category;
    in property <image> fragrance-image;
    in property <float> image_offset_x;
    in property <float> image_offset_y;
    in property <float> image_scale: 1.0;

    callback card_clicked();

    width: 220px;
    height: 320px;

    background: #242424;
    border-radius: 12px;

    TouchArea {
        clicked => {
            root.card_clicked();
        }
    }

    VerticalBox {
        padding: 12px;
        spacing: 6px;

        Rectangle {
            width: 140px;
            height: 140px;
            clip: true;

            Image {
                source: root.fragrance-image;
                width: 140px * root.image_scale;
                height: 140px * root.image_scale;
                x: (140px - self.width) / 2 + root.image_offset_x * 1px;
                y: (140px - self.height) / 2 + root.image_offset_y * 1px;
                image-fit: contain;
            }
        }

        HorizontalBox {
            spacing: 8px;

            Text {
                text: brand + " - " + name;
                color: white;
                font-size: 16px;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }

            Text {
                text: category;
                color: #66aaff;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        Text {
            text: "⭐ " + rating;
            color: white;
            font-size: 13px;
        }

        Text {
            text: notes;
            color: #aaaaaa;
            font-size: 12px;
            wrap: word-wrap;
            overflow: elide;
        }

        Text {
            text: seasons;
            color: #aaaaaa;
            font-size: 12px;
        }
    }
}