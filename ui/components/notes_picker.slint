import { VerticalBox, HorizontalBox, ScrollView, LineEdit, Button, CheckBox } from "std-widgets.slint";
import { NoteChoice } from "../types.slint";
import { Theme } from "../theme.slint";

export component NotesPicker inherits Rectangle {
    in property <[NoteChoice]> initial_choices;
    callback note_created(string, [NoteChoice]) -> [NoteChoice];
    callback search_changed(string, [NoteChoice]) -> [NoteChoice];

    out property <[NoteChoice]> choices;
    property <string> search_text;

    init => {
        root.choices = root.initial_choices;
    }

    VerticalBox {
        spacing: Theme.space-sm;

        HorizontalBox {
            spacing: Theme.space-xs;

            for choice[i] in root.choices : Rectangle {
                if choice.selected : Rectangle {
                    height: 26px;
                    background: Theme.accent-soft;
                    border-radius: 13px;

                    HorizontalBox {
                        padding-left: 10px;
                        padding-right: 6px;
                        spacing: 4px;

                        Text {
                            text: choice.name;
                            color: Theme.accent;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            width: 16px;
                            height: 16px;

                            clicked => {
                                root.choices[i].selected = false;
                            }

                            Text {
                                text: "×";
                                color: Theme.accent;
                                font-size: 14px;
                                width: 100%;
                                height: 100%;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        HorizontalBox {
            spacing: Theme.space-sm;

            LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "Search or add a note...";
                text: root.search_text;

                edited => {
                    root.search_text = self.text;
                    root.choices = root.search_changed(self.text, root.choices);
                }
            }

            if root.search_text != "" : Button {
                text: "+ Add \"" + root.search_text + "\"";

                clicked => {
                    root.choices = root.note_created(root.search_text, root.choices);
                    root.search_text = "";
                }
            }
        }

        Rectangle {
            height: 140px;
            background: Theme.bg-card-alt;
            border-radius: Theme.radius-sm;
            clip: true;

            ScrollView {
                VerticalBox {
                    padding: Theme.space-xs;
                    spacing: 2px;

                    for choice[i] in root.choices : Rectangle {
                        if choice.matches : CheckBox {
                            text: choice.name;
                            checked: choice.selected;

                            toggled => {
                                root.choices[i].selected = self.checked;
                            }
                        }
                    }
                }
            }
        }
    }
}