import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { sidebar } from "./components/sidebar.slint";
import { Dashboard } from "./pages/dashboard.slint";
import { CollectionPage } from "./pages/collection.slint";
import { WishlistPage } from "./pages/wishlist.slint";
import { FragranceDetails } from "./pages/fragrance_details.slint";
import { AddFragrance } from "./pages/add_fragrance.slint";
import { EditFragrance } from "./pages/edit_fragrance.slint";
import { SettingsPage } from "./pages/settings.slint";
import { RankingsPage } from "./pages/rankings.slint";
import { Page, FragranceRow, FragranceData, FragranceInput, ImageSelection, DashboardData, AppUser, RankingItem } from "./types.slint";

export component MainWindow inherits Window {
    callback save_requested(FragranceInput);
    callback add_fragrance(FragranceInput);
    callback delete_requested(int);
    callback refresh_collection(string);
    callback search_collection(string);
    callback choose_image_requested();
    callback choose_image_requested_edit() -> ImageSelection;
    callback add_user_requested(string);
    callback update_user_requested(int, string);
    callback delete_user_requested(int);
    callback rank_requested(string, string);

    width: 1200px;
    height: 800px;

    in-out property <Page> current-page: Page.Dashboard;
    in property <[FragranceRow]> rows;
    in property <[FragranceRow]> wishlist_rows;
    in property <DashboardData> dashboard;
    in property <[AppUser]> users;
    in property <[string]> user_names;
    in property <[RankingItem]> ranking_items;
    property <FragranceData> selected-fragrance;
    in-out property <string> selected-image-path: "";
    property <string> current-sort: "Rating: High → Low";

    title: "Fragrance Vault";
    background: #121212;

    HorizontalBox {
        sidebar {
            dashboard_requested => {
                root.current-page = Page.Dashboard;
            }

            collection_requested => {
                root.current-page = Page.Collection;
            }

            add_requested => {
                root.current-page = Page.Add;
            }

            settings_requested => {
                root.current-page = Page.Settings;
            }

            rankings_requested => {
                root.current-page = Page.Rankings;
            }

            wishlist_requested => {
                root.current-page = Page.Wishlist;
            }
        }

        Rectangle {
            horizontal-stretch: 1;

            if root.current-page == Page.Dashboard : Dashboard {
                dashboard: root.dashboard;

                fragrance_clicked(fragrance) => {
                    root.selected-fragrance = fragrance;
                    root.current-page = Page.Details;
                }
            }

            if root.current-page == Page.Collection : CollectionPage {
                rows: root.rows;

                fragrance_clicked(fragrance) => {
                    root.selected-fragrance = fragrance;
                    root.current-page = Page.Details;
                }

                sort_requested(option) => {
                    root.refresh_collection(option);
                }

                search_requested(text) => {
                    root.search_collection(text);
                }
            }

            if root.current-page == Page.Wishlist : WishlistPage {
                rows: root.wishlist_rows;

                fragrance_clicked(fragrance) => {
                    root.selected-fragrance = fragrance;
                    root.current-page = Page.Details;
                }
            }

            if root.current-page == Page.Details : FragranceDetails {
                fragrance: root.selected-fragrance;

                edit_requested => {
                    root.current-page = Page.Edit;
                }

                delete_requested => {
                    root.delete_requested(root.selected-fragrance.id);
                    root.current-page = Page.Collection;
                }

                back_requested => {
                    root.current-page = Page.Collection;
                }
            }

            if root.current-page == Page.Edit : EditFragrance {
                fragrance: root.selected-fragrance;

                cancel_requested => {
                    root.current-page = Page.Details;
                }

                choose_image_requested => {
                    return root.choose_image_requested_edit();
                }

                save_requested(input) => {
                    root.save_requested(input);
                    root.current-page = Page.Details;
                }
            }

            if root.current-page == Page.Add : AddFragrance {
                image_path <=> root.selected-image-path;

                choose_image_requested => {
                    root.choose_image_requested();
                }

                add_requested(input) => {
                    root.add_fragrance(input);
                    root.current-page = Page.Collection;
                }

                cancel_requested => {
                    root.current-page = Page.Collection;
                }
            }

            if root.current-page == Page.Settings : SettingsPage {
                users: root.users;

                add_user_requested(name) => {
                    root.add_user_requested(name);
                }

                update_user_requested(id, name) => {
                    root.update_user_requested(id, name);
                }

                delete_user_requested(id) => {
                    root.delete_user_requested(id);
                }
            }

            if root.current-page == Page.Rankings : RankingsPage {
                ranking_items: root.ranking_items;
                user_names: root.user_names;

                rank_requested(mode, option) => {
                    root.rank_requested(mode, option);
                }
            }
        }
    }
}