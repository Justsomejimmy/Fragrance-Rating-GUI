import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { sidebar } from "./components/sidebar.slint";
import { CollectionPage } from "./pages/collection.slint";
import { FragranceDetails } from "./pages/fragrance_details.slint";
import { EditFragrance } from "./pages/edit_fragrance.slint";
import { Page, FragranceRow, FragranceData, FragranceInput, ImageSelection } from "./types.slint";
import { AddFragrance } from "./pages/add_fragrance.slint";

export component MainWindow inherits Window {
    callback save_requested(FragranceInput);
    callback add_fragrance(FragranceInput);
    callback delete_requested(int);
    callback refresh_collection(string);
    callback search_collection(string);
    callback choose_image_requested();
    callback choose_image_requested_edit() -> ImageSelection;

    width: 1200px;
    height: 800px;

    in-out property <Page> current-page: Page.Collection;
    in property <[FragranceRow]> rows;
    property <FragranceData> selected-fragrance;
    in-out property <string> selected-image-path: "";
    property <string> current-sort: "Rating: High → Low";

    title: "Fragrance Vault";
    background: #121212;

    HorizontalBox {
        sidebar {
            add_requested => {
                root.current-page = Page.Add;
            }
        }

        Rectangle {
            horizontal-stretch: 1;

            if root.current-page == Page.Collection : CollectionPage {
                rows: root.rows;

                fragrance_clicked(fragrance) => {
                    root.selected-fragrance = fragrance;
                    root.current-page = Page.Details;
                }

                sort_requested(option) => {
                    root.refresh_collection(option);
                }

                search_requested(text) => {
                    root.search_collection(text);
                }
            }

            if root.current-page == Page.Details : FragranceDetails {
                fragrance: root.selected-fragrance;

                edit_requested => {
                    root.current-page = Page.Edit;
                }

                delete_requested => {
                    root.delete_requested(root.selected-fragrance.id);
                    root.current-page = Page.Collection;
                }

                back_requested => {
                    root.current-page = Page.Collection;
                }
            }

            if root.current-page == Page.Edit : EditFragrance {
                fragrance: root.selected-fragrance;

                cancel_requested => {
                    root.current-page = Page.Details;
                }

                choose_image_requested => {
                    return root.choose_image_requested_edit();
                }

                save_requested(input) => {
                    root.selected-fragrance = {
                        id: input.id,
                        brand: input.brand,
                        name: input.name,
                        concentration: input.concentration,
                        projection: input.projection,
                        longevity: input.longevity,
                        price: input.price,
                        purchase_date: input.purchase_date,
                        rating: input.rating,
                        notes: input.notes,
                        seasons: root.selected-fragrance.seasons,
                        image: root.selected-fragrance.image,
                        my_notes: input.my_notes,
                        partner_notes: input.partner_notes,
                        image_path: input.image_path,
                        image_offset_x: input.image_offset_x,
                        image_offset_y: input.image_offset_y,
                        image_scale: input.image_scale,
                        season_spring: input.season_spring,
                        season_summer: input.season_summer,
                        season_fall: input.season_fall,
                        season_winter: input.season_winter,
                        category: input.category,
                    };

                    root.save_requested(input);
                    root.current-page = Page.Details;
                }
            }

            if root.current-page == Page.Add : AddFragrance {
                image_path <=> root.selected-image-path;

                choose_image_requested => {
                    root.choose_image_requested();
                }

                add_requested(input) => {
                    root.add_fragrance(input);
                    root.current-page = Page.Collection;
                }

                cancel_requested => {
                    root.current-page = Page.Collection;
                }
            }
        }
    }
}