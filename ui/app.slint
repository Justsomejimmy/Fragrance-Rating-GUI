import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { sidebar } from "./components/sidebar.slint";
import { CollectionPage } from "./pages/collection.slint";
import { FragranceData } from "./types.slint";

export component MainWindow inherits Window {
    width: 1200px;
    height: 800px;

    in property <[FragranceData]> fragrances;

    title: "Fragrance Vault";

    background: #121212;

    HorizontalBox {
        sidebar{}

        // Main Content Area
        Rectangle {
            horizontal-stretch: 1;
            CollectionPage {
                fragrances: root.fragrances;
            }
        }
    }
}