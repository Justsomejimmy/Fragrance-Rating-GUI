import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { sidebar } from "./components/sidebar.slint";

export component MainWindow inherits Window {

    width: 1200px;
    height: 800px;

    title: "Fragrance Vault";

    background: #121212;

    HorizontalBox {
        sidebar{}

        // Main Content Area
        Rectangle {
            horizontal-stretch: 1;
            background: #181818;

            VerticalBox {

                padding: 30px;

                Text {
                    text: "Collection";
                    font-size: 32px;
                    color: white;
                }

                Text {
                    text: "Your fragrance collection will appear here.";
                    font-size: 18px;
                    color: #aaaaaa;
                }

            }
        }
    }
}