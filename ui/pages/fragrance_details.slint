import { VerticalBox, HorizontalBox, Button } from "std-widgets.slint";
import { FragranceData } from "../types.slint";

export component FragranceDetails inherits Rectangle {
    in property <FragranceData> fragrance;
    property <bool> show-delete-confirmation: false;

    callback back_requested();
    callback edit_requested();
    callback delete_requested();

    background: #181818;

    VerticalBox {
        padding: 30px;
        spacing: 12px;

        Button {
            text: "← Back";

            clicked => {
                root.back_requested();
            }
        }

        Text {
            text: fragrance.brand + " " + fragrance.name;
            color: white;
            font-size: 32px;
        }

        Text {
            text: fragrance.category;
            color: #66aaff;
            font-size: 16px;
        }

        Text {
            text: "Concentration: " + fragrance.concentration;
            color: white;
        }

        Text {
            text: "Projection: " + fragrance.projection;
            color: white;
        }

        Text {
            text: "Longevity: " + fragrance.longevity;
            color: white;
        }

        Text {
            text: "Rating: ⭐ " + fragrance.rating;
            color: white;
        }

        Text {
            text: "Price: " + fragrance.price;
            color: white;
        }

        Text {
            text: "Purchased: " + fragrance.purchase_date;
            color: white;
        }

        Text {
            text: "Notes: " + fragrance.notes;
            color: white;
        }

        Text {
            text: "Seasons: " + fragrance.seasons;
            color: #aaaaaa;
        }

        Text {
            text: "My Notes: " + fragrance.my_notes;
            color: white;
        }

        Text {
            text: "Partner Notes: " + fragrance.partner_notes;
            color: white;
        }

        HorizontalBox {
            spacing: 20px;

            Button {
                text: "Edit";

                clicked => {
                    root.edit_requested();
                }
            }

            Button {
                text: "Delete";

                clicked => {
                    root.show-delete-confirmation = true;
                }
            }
        }
    }

    if root.show-delete-confirmation : Rectangle {
        width: parent.width;
        height: parent.height;

        background: #000000aa;

        Rectangle {
            width: 400px;
            height: 200px;

            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            background: #252525;
            border-radius: 12px;

            VerticalBox {
                padding: 25px;
                spacing: 20px;

                Text {
                    text: "Delete this fragrance?";
                    color: white;
                    font-size: 22px;
                    horizontal-alignment: center;
                }

                Text {
                    text: "This action cannot be undone.";
                    color: #aaaaaa;
                    horizontal-alignment: center;
                }

                HorizontalBox {
                    spacing: 15px;

                    Button {
                        text: "Cancel";

                        clicked => {
                            root.show-delete-confirmation = false;
                        }
                    }

                    Button {
                        text: "Delete";

                        clicked => {
                            root.show-delete-confirmation = false;
                            root.delete_requested();
                        }
                    }
                }
            }
        }
    }
}