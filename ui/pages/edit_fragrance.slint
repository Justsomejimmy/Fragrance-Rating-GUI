import { VerticalBox, HorizontalBox, ScrollView, Button, LineEdit, Slider, CheckBox } from "std-widgets.slint";
import { FragranceData, FragranceInput, ImageSelection, UserRating } from "../types.slint";
import { CategoryChip } from "../components/category_chip.slint";

export component EditFragrance inherits Rectangle {
    in property <FragranceData> fragrance;

    property <string> brand;
    property <string> name;
    property <string> concentration;
    property <string> projection;
    property <string> longevity;
    property <string> price;
    property <string> purchase_date;
    property <string> notes;
    property <bool> season_spring;
    property <bool> season_summer;
    property <bool> season_fall;
    property <bool> season_winter;
    property <string> category;
    property <string> my_notes;
    property <string> partner_notes;
    property <[UserRating]> ratings;

    property <string> image_path;
    property <image> preview_image;
    property <length> offset_x;
    property <length> offset_y;
    property <float> scale: 1.0;

    property <length> drag_start_offset_x;
    property <length> drag_start_offset_y;

    property <length> preview_size: 240px;

    init => {
        root.brand = fragrance.brand;
        root.name = fragrance.name;
        root.concentration = fragrance.concentration;
        root.projection = fragrance.projection;
        root.longevity = fragrance.longevity;
        root.price = fragrance.price;
        root.purchase_date = fragrance.purchase_date;
        root.notes = fragrance.notes;
        root.season_spring = fragrance.season_spring;
        root.season_summer = fragrance.season_summer;
        root.season_fall = fragrance.season_fall;
        root.season_winter = fragrance.season_winter;
        root.category = fragrance.category == "" ? "Perfume" : fragrance.category;
        root.my_notes = fragrance.my_notes;
        root.partner_notes = fragrance.partner_notes;
        root.ratings = fragrance.ratings;

        root.image_path = fragrance.image_path;
        root.preview_image = fragrance.image;
        root.offset_x = fragrance.image_offset_x * 1px;
        root.offset_y = fragrance.image_offset_y * 1px;
        root.scale = fragrance.image_scale <= 0 ? 1.0 : fragrance.image_scale;
    }

    callback save_requested(FragranceInput);
    callback cancel_requested();
    callback choose_image_requested() -> ImageSelection;

    function apply-image-selection(sel: ImageSelection) {
        if (sel.path != "") {
            root.image_path = sel.path;
            root.preview_image = sel.picture;
            root.offset_x = 0px;
            root.offset_y = 0px;
            root.scale = 1.0;
        }
    }

    background: #181818;

    ScrollView {
        VerticalBox {
            padding: 30px;
            spacing: 15px;

            Text {
                text: "Edit Fragrance";
                font-size: 32px;
                color: white;
            }

            HorizontalBox {
                spacing: 20px;

                Rectangle {
                    width: root.preview_size;
                    height: root.preview_size;
                    clip: true;
                    border-radius: 8px;
                    background: #000000;

                    Image {
                        source: root.preview_image;
                        width: root.preview_size * root.scale;
                        height: root.preview_size * root.scale;
                        x: (root.preview_size - self.width) / 2 + root.offset_x;
                        y: (root.preview_size - self.height) / 2 + root.offset_y;
                        image-fit: contain;
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;

                        moved => {
                            if (self.pressed) {
                                root.offset_x = root.drag_start_offset_x + (self.mouse-x - self.pressed-x);
                                root.offset_y = root.drag_start_offset_y + (self.mouse-y - self.pressed-y);
                            }
                        }

                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                root.drag_start_offset_x = root.offset_x;
                                root.drag_start_offset_y = root.offset_y;
                            }
                        }

                        scroll-event(event) => {
                            root.scale = max(0.2, min(5.0, root.scale + (event.delta-y / 1px) / 1000));
                            accept
                        }
                    }
                }

                VerticalBox {
                    spacing: 10px;

                    Button {
                        text: "Change Image";

                        clicked => {
                            root.apply-image-selection(root.choose_image_requested());
                        }
                    }

                    Button {
                        text: "Reset Position/Zoom";

                        clicked => {
                            root.offset_x = 0px;
                            root.offset_y = 0px;
                            root.scale = 1.0;
                        }
                    }

                    Text {
                        text: "Drag image to reposition, scroll to zoom";
                        color: #aaaaaa;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            LineEdit {
                text: root.brand;
                placeholder-text: "Brand";
                edited => { root.brand = self.text; }
            }

            LineEdit {
                text: root.name;
                placeholder-text: "Name";
                edited => { root.name = self.text; }
            }

            VerticalBox {
                spacing: 5px;

                Text {
                    text: "Ratings";
                    color: white;
                    font-size: 16px;
                }

                for entry[i] in root.ratings : VerticalBox {
                    spacing: 3px;

                    HorizontalBox {
                        spacing: 10px;

                        Text {
                            text: entry.user_name + ":";
                            color: white;
                            font-size: 14px;
                            vertical-alignment: center;
                            width: 100px;
                        }

                        LineEdit {
                            width: 55px;
                            text: entry.rating;

                            edited => {
                                root.ratings[i].rating = max(0.0, min(10.0, self.text.to-float()));
                            }
                        }

                        Text {
                            text: "/ 10";
                            color: white;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }

                    Slider {
                        minimum: 0;
                        maximum: 10;
                        value: entry.rating;

                        changed(new-value) => {
                            root.ratings[i].rating = round(new-value * 10) / 10;
                        }
                    }
                }
            }

            LineEdit {
                text: root.concentration;
                placeholder-text: "Concentration";
                edited => { root.concentration = self.text; }
            }

            LineEdit {
                text: root.projection;
                placeholder-text: "Projection";
                edited => { root.projection = self.text; }
            }

            LineEdit {
                text: root.longevity;
                placeholder-text: "Longevity";
                edited => { root.longevity = self.text; }
            }

            LineEdit {
                text: root.price;
                placeholder-text: "Price";
                edited => { root.price = self.text; }
            }

            LineEdit {
                text: root.purchase_date;
                placeholder-text: "Purchase Date";
                edited => { root.purchase_date = self.text; }
            }

            LineEdit {
                text: root.notes;
                placeholder-text: "Notes";
                edited => { root.notes = self.text; }
            }

            VerticalBox {
                spacing: 5px;

                Text {
                    text: "Seasons";
                    color: white;
                    font-size: 16px;
                }

                HorizontalBox {
                    spacing: 15px;

                    CheckBox {
                        text: "Spring";
                        checked <=> root.season_spring;
                    }

                    CheckBox {
                        text: "Summer";
                        checked <=> root.season_summer;
                    }

                    CheckBox {
                        text: "Fall";
                        checked <=> root.season_fall;
                    }

                    CheckBox {
                        text: "Winter";
                        checked <=> root.season_winter;
                    }
                }
            }

            VerticalBox {
                spacing: 5px;

                Text {
                    text: "Category";
                    color: white;
                    font-size: 16px;
                }

                HorizontalBox {
                    spacing: 15px;

                    CategoryChip {
                        label: "Perfume";
                        selected: root.category == "Perfume";
                        selected_requested => { root.category = "Perfume"; }
                    }

                    CategoryChip {
                        label: "Unisex";
                        selected: root.category == "Unisex";
                        selected_requested => { root.category = "Unisex"; }
                    }

                    CategoryChip {
                        label: "Cologne";
                        selected: root.category == "Cologne";
                        selected_requested => { root.category = "Cologne"; }
                    }
                }
            }

            LineEdit {
                text: root.my_notes;
                placeholder-text: "My Notes";
                edited => { root.my_notes = self.text; }
            }

            LineEdit {
                text: root.partner_notes;
                placeholder-text: "Partner Notes";
                edited => { root.partner_notes = self.text; }
            }

            HorizontalBox {
                spacing: 20px;

                Button {
                    text: "Save";

                    clicked => {
                        root.save_requested({
                            id: root.fragrance.id,
                            brand: root.brand,
                            name: root.name,
                            concentration: root.concentration,
                            projection: root.projection,
                            longevity: root.longevity,
                            price: root.price,
                            purchase_date: root.purchase_date,
                            notes: root.notes,
                            season_spring: root.season_spring,
                            season_summer: root.season_summer,
                            season_fall: root.season_fall,
                            season_winter: root.season_winter,
                            category: root.category,
                            my_notes: root.my_notes,
                            partner_notes: root.partner_notes,
                            image_path: root.image_path,
                            image_offset_x: root.offset_x / 1px,
                            image_offset_y: root.offset_y / 1px,
                            image_scale: root.scale,
                            ratings: root.ratings,
                            send_to_wishlist: false,
                        });
                    }
                }

                Button {
                    text: "Cancel";
                    clicked => { root.cancel_requested(); }
                }
            }
        }
    }
}