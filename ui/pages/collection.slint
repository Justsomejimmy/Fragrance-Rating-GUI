import { VerticalBox, HorizontalBox, ScrollView, ComboBox, LineEdit, Button } from "std-widgets.slint";
import { FragranceCard } from "../components/fragrance_card.slint";
import { AddFragranceCard } from "../components/add_fragrance_card.slint";
import { FragranceData, FragranceRow } from "../types.slint";
import { Theme } from "../theme.slint";

export component CollectionPage inherits Rectangle {
    in-out property <string> sort-option: "Rating: High → Low";
    in-out property <string> search-text: "";
    in property <image> fragrance-image;
    in property <[FragranceRow]> rows;
    in property <[string]> user_names;
    in property <[string]> all_note_names;

    property <string> rating_user: "";
    property <string> note_filter: "";

    callback add_requested();
    callback fragrance_clicked(FragranceData);
    callback search_requested(string);
    callback sort_requested(string, string);

    background: Theme.bg-app;

    VerticalBox {
        padding: Theme.space-lg;
        spacing: Theme.space-lg;

        VerticalBox {
            spacing: 2px;

            Text {
                text: "Collection";
                font-size: Theme.title-size;
                font-weight: 800;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }

            Text {
                text: "Browse your fragrances";
                font-size: Theme.subtitle-size;
                font-weight: 500;
                color: Theme.text-secondary;
                horizontal-alignment: center;
            }
        }

        Rectangle {
            background: Theme.bg-card;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            height: 70px;

            HorizontalBox {
                padding: Theme.space-sm;
                spacing: Theme.space-sm;

                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "Search fragrances...";
                    text <=> root.search-text;

                    edited => {
                        root.search_requested(self.text);
                    }
                }

                Button {
                    width: 70px;
                    text: "Clear";

                    clicked => {
                        root.search-text = "";
                        root.search_requested("");
                    }
                }

                ComboBox {
                    width: 190px;

                    model: [
                        "Rating: High → Low",
                        "Rating: Low → High",
                        "Name: A → Z",
                        "Name: Z → A",
                        "Category",
                        "Price: Low → High",
                        "Price: High → Low",
                        "Purchase Date: Oldest",
                        "Purchase Date: Newest",
                        "By Note",
                        "Rating by User"
                    ];

                    current-value <=> root.sort-option;

                    selected => {
                        if (root.sort-option == "Rating by User") {
                            if (root.user_names.length > 0) {
                                root.rating_user = root.user_names[0];
                                root.sort_requested(root.sort-option, root.rating_user);
                            }
                        } else if (root.sort-option == "By Note") {
                            if (root.all_note_names.length > 0) {
                                root.note_filter = root.all_note_names[0];
                                root.sort_requested(root.sort-option, root.note_filter);
                            }
                        } else {
                            root.sort_requested(root.sort-option, "");
                        }
                    }
                }

                if root.sort-option == "Rating by User" : ComboBox {
                    width: 150px;
                    model: root.user_names;
                    current-value <=> root.rating_user;

                    selected => {
                        root.sort_requested(root.sort-option, root.rating_user);
                    }
                }

                if root.sort-option == "By Note" : ComboBox {
                    width: 150px;
                    model: root.all_note_names;
                    current-value <=> root.note_filter;

                    selected => {
                        root.sort_requested(root.sort-option, root.note_filter);
                    }
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalBox {
                spacing: Theme.space-md;

                if root.rows.length == 0 : HorizontalBox {
                    spacing: Theme.space-md;

                    AddFragranceCard {
                        card_clicked => {
                            root.add_requested();
                        }
                    }
                }

                for row[i] in root.rows : HorizontalBox {
                    spacing: Theme.space-md;

                    if i == 0 : AddFragranceCard {
                        card_clicked => {
                            root.add_requested();
                        }
                    }

                    for fragrance in row.fragrances : FragranceCard {
                        brand: fragrance.brand;
                        name: fragrance.name;
                        rating: fragrance.rating;
                        notes: fragrance.notes;
                        seasons: fragrance.seasons;
                        category: fragrance.category;
                        fragrance-image: fragrance.image;
                        image_offset_x: fragrance.image_offset_x;
                        image_offset_y: fragrance.image_offset_y;
                        image_scale: fragrance.image_scale;

                        card_clicked => {
                            root.fragrance_clicked(fragrance);
                        }
                    }
                }
            }
        }
    }
}