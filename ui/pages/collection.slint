import { VerticalBox, HorizontalBox, ScrollView, ComboBox, LineEdit } from "std-widgets.slint";
import { FragranceCard } from "../components/fragrance_card.slint";
import { FragranceData, FragranceRow } from "../types.slint";

export component CollectionPage inherits Rectangle {
    in-out property <string> sort-option: "Rating: High → Low";
    in-out property <string> search-text: "";

    in property <[FragranceRow]> rows;

    callback fragrance_clicked(FragranceData);
    callback sort_changed(string);
    callback search_changed(string);

    background: #181818;

    VerticalBox {
        padding: 30px;
        spacing: 20px;

        HorizontalBox {
            spacing: 20px;

            Text {
                text: "Collection";
                font-size: 32px;
                color: white;
                vertical-alignment: center;
            }

            LineEdit {
                width: 250px;
                placeholder-text: "Search fragrances...";
                text <=> root.search-text;

                edited => {
                    root.search_changed(root.search-text);
                }
            }

            ComboBox {
                width: 180px;

                model: [
                    "Rating: High → Low",
                    "Rating: Low → High",
                    "Name: A → Z",
                    "Name: Z → A"
                ];

                current-value <=> root.sort-option;

                selected(value) => {
                    root.sort_changed(value);
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalBox {
                spacing: 20px;

                for row in root.rows : HorizontalBox {
                    spacing: 20px;

                    for fragrance in row.fragrances : FragranceCard {
                        brand: fragrance.brand;
                        name: fragrance.name;
                        rating: fragrance.rating;
                        notes: fragrance.notes;
                        seasons: fragrance.seasons;

                        card_clicked => {
                            root.fragrance_clicked(fragrance);
                        }
                    }
                }
            }
        }
    }
}