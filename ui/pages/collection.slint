import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { FragranceCard } from "../components/fragrance_card.slint";
import { FragranceData } from "../types.slint";

export component CollectionPage inherits Rectangle {
    in property <[FragranceData]> fragrances;

    background: #181818;

    VerticalBox {
        padding: 30px;
        spacing: 20px;

        Text {
            text: "Collection";
            font-size: 32px;
            color: white;
        }

        HorizontalBox {
            spacing: 20px;

            for fragrance in fragrances : FragranceCard {
                brand: fragrance.brand;
                name: fragrance.name;
                rating: fragrance.rating;
                notes: fragrance.notes;
                seasons: fragrance.seasons;
            }
        }
    }
}