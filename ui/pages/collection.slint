import { VerticalBox, ScrollView, GridBox } from "std-widgets.slint";
import { FragranceCard } from "../components/fragrance_card.slint";
import { FragranceData } from "../types.slint";

export component CollectionPage inherits Rectangle {
    in property <[FragranceData]> fragrances;

    background: #181818;

    VerticalBox {

        padding: 30px;
        spacing: 20px;

        Text {
            text: "Collection";
            font-size: 32px;
            color: white;
        }

        ScrollView {

            vertical-stretch: 1;

            GridBox {

                spacing: 20px;

                for fragrance[index] in fragrances : FragranceCard {
                    row: index / 3;
                    col: Math.mod(index, 3);

                    brand: fragrance.brand;
                    name: fragrance.name;
                    rating: fragrance.rating;
                    notes: fragrance.notes;
                    seasons: fragrance.seasons;
                }
            }
        }
    }
}