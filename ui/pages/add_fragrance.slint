import { VerticalBox, HorizontalBox, ScrollView, Button, LineEdit, CheckBox } from "std-widgets.slint";
import { FragranceData, FragranceInput } from "../types.slint";
import { CategoryChip } from "../components/category_chip.slint";

export component AddFragrance inherits Rectangle {
    callback add_requested(FragranceInput);
    callback cancel_requested();
    callback choose_image_requested();

    property <string> brand;
    property <string> name;
    property <string> concentration;
    property <string> projection;
    property <string> longevity;
    property <string> price;
    property <string> purchase_date;
    property <string> notes;
    property <bool> season_spring;
    property <bool> season_summer;
    property <bool> season_fall;
    property <bool> season_winter;
    property <string> category: "Perfume";
    property <string> my_notes;
    property <string> partner_notes;

    in-out property <string> image_path;

    background: #181818;

    ScrollView {
        VerticalBox {
            padding: 30px;
            spacing: 15px;

            Text {
                text: "Add Fragrance";
                font-size: 32px;
                color: white;
            }

            HorizontalBox {
                spacing: 10px;

                Button {
                    text: "Choose Image";

                    clicked => {
                        root.choose_image_requested();
                    }
                }

                Text {
                    text: root.image_path == "" ? "No image selected" : root.image_path;
                    color: #aaaaaa;
                    vertical-alignment: center;
                }
            }

            LineEdit {
                placeholder-text: "Brand";
                text <=> root.brand;
            }

            LineEdit {
                placeholder-text: "Name";
                text <=> root.name;
            }

            LineEdit {
                placeholder-text: "Concentration";
                text <=> root.concentration;
            }

            LineEdit {
                placeholder-text: "Projection";
                text <=> root.projection;
            }

            LineEdit {
                placeholder-text: "Longevity";
                text <=> root.longevity;
            }

            LineEdit {
                placeholder-text: "Price";
                text <=> root.price;
            }

            LineEdit {
                placeholder-text: "Purchase Date";
                text <=> root.purchase_date;
            }

            LineEdit {
                placeholder-text: "Notes";
                text <=> root.notes;
            }

            VerticalBox {
                spacing: 5px;

                Text {
                    text: "Seasons";
                    color: white;
                    font-size: 16px;
                }

                HorizontalBox {
                    spacing: 15px;

                    CheckBox {
                        text: "Spring";
                        checked <=> root.season_spring;
                    }

                    CheckBox {
                        text: "Summer";
                        checked <=> root.season_summer;
                    }

                    CheckBox {
                        text: "Fall";
                        checked <=> root.season_fall;
                    }

                    CheckBox {
                        text: "Winter";
                        checked <=> root.season_winter;
                    }
                }
            }

            VerticalBox {
                spacing: 5px;

                Text {
                    text: "Category";
                    color: white;
                    font-size: 16px;
                }

                HorizontalBox {
                    spacing: 15px;

                    CategoryChip {
                        label: "Perfume";
                        selected: root.category == "Perfume";
                        selected_requested => { root.category = "Perfume"; }
                    }

                    CategoryChip {
                        label: "Unisex";
                        selected: root.category == "Unisex";
                        selected_requested => { root.category = "Unisex"; }
                    }

                    CategoryChip {
                        label: "Cologne";
                        selected: root.category == "Cologne";
                        selected_requested => { root.category = "Cologne"; }
                    }
                }
            }

            LineEdit {
                placeholder-text: "My Notes";
                text <=> root.my_notes;
            }

            LineEdit {
                placeholder-text: "Partner Notes";
                text <=> root.partner_notes;
            }

            HorizontalBox {
                spacing: 20px;

                Button {
                    text: "Add";

                    clicked => {
                        root.add_requested({
                            id: 0,
                            brand: root.brand,
                            name: root.name,
                            concentration: root.concentration,
                            projection: root.projection,
                            longevity: root.longevity,
                            price: root.price,
                            purchase_date: root.purchase_date,
                            notes: root.notes,
                            season_spring: root.season_spring,
                            season_summer: root.season_summer,
                            season_fall: root.season_fall,
                            season_winter: root.season_winter,
                            category: root.category,
                            my_notes: root.my_notes,
                            partner_notes: root.partner_notes,
                            image_path: root.image_path,
                            image_offset_x: 0,
                            image_offset_y: 0,
                            image_scale: 1.0,
                            ratings: [],
                        });
                    }
                }

                Button {
                    text: "Cancel";

                    clicked => {
                        root.cancel_requested();
                    }
                }
            }
        }
    }
}