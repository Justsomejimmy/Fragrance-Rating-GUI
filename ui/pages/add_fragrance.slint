import { VerticalBox, HorizontalBox, Button, LineEdit, CheckBox, ScrollView, Slider } from "std-widgets.slint";
import { FragranceData, FragranceInput, UserRating, ImportResult, NoteChoice, ValidationErrors } from "../types.slint";
import { CategoryChip } from "../components/category_chip.slint";
import { NotesPicker } from "../components/notes_picker.slint";
import { Theme } from "../theme.slint";

component SectionCard inherits Rectangle {
    background: Theme.bg-card;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;
}

component SectionLabel inherits Text {
    color: Theme.text-primary;
    font-size: 16px;
    font-weight: 700;
}

component FieldError inherits Text {
    color: #e57373;
    font-size: 12px;
}

export component AddFragrance inherits Rectangle {
    in property <[UserRating]> initial_ratings;
    in property <[NoteChoice]> initial_note_choices;

    callback add_requested(FragranceInput);
    callback cancel_requested();
    callback choose_image_requested();
    callback import_from_url_requested(string) -> ImportResult;
    callback note_created(string, [NoteChoice]) -> [NoteChoice];
    callback search_changed(string, [NoteChoice]) -> [NoteChoice];
    callback validate_fragrance(FragranceInput) -> ValidationErrors;

    property <string> brand;
    property <string> name;
    property <string> concentration;
    property <string> projection;
    property <string> longevity;
    property <string> price;
    property <string> purchase_date;
    property <bool> season_spring;
    property <bool> season_summer;
    property <bool> season_fall;
    property <bool> season_winter;
    property <string> category: "Perfume";
    property <string> my_notes;
    property <string> partner_notes;
    property <string> list_choice: "Collection";
    property <[UserRating]> ratings;

    property <string> import_url;
    property <string> import_error;

    property <ValidationErrors> errors;

    in-out property <string> image_path;

    init => {
        root.ratings = root.initial_ratings;
    }

    function apply-import(result: ImportResult) {
        if (result.success) {
            root.import_error = "";
            if (result.brand != "") { root.brand = result.brand; }
            if (result.name != "") { root.name = result.name; }
            if (result.notes != "") { root.my_notes = result.notes; }
            if (result.price != "") { root.price = result.price; }
            if (result.image_path != "") { root.image_path = result.image_path; }
        } else {
            root.import_error = result.error;
        }
    }

    function build-input() -> FragranceInput {
        return {
            id: 0,
            brand: root.brand,
            name: root.name,
            concentration: root.concentration,
            projection: root.projection,
            longevity: root.longevity,
            price: root.price,
            purchase_date: root.purchase_date,
            season_spring: root.season_spring,
            season_summer: root.season_summer,
            season_fall: root.season_fall,
            season_winter: root.season_winter,
            category: root.category,
            my_notes: root.my_notes,
            partner_notes: root.partner_notes,
            image_path: root.image_path,
            image_offset_x: 0,
            image_offset_y: 0,
            image_scale: 1.0,
            ratings: root.ratings,
            send_to_wishlist: root.list_choice == "Wishlist",
            note_choices: notes-picker.choices,
        };
    }

    background: Theme.bg-app;

    ScrollView {
        VerticalBox {
            padding: Theme.space-lg;
            spacing: Theme.space-lg;

            VerticalBox {
                spacing: 2px;

                Text {
                    text: "Add Fragrance";
                    font-size: Theme.title-size;
                    font-weight: 800;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Add a new fragrance to your collection or wishlist";
                    font-size: Theme.subtitle-size;
                    font-weight: 500;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }
            }

            SectionCard {
                VerticalBox {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;

                    SectionLabel {
                        text: "Image";
                    }

                    HorizontalBox {
                        spacing: Theme.space-sm;

                        Button {
                            text: "Choose Image";

                            clicked => {
                                root.choose_image_requested();
                            }
                        }

                        Text {
                            text: root.image_path == "" ? "No image selected" : root.image_path;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            SectionCard {
                VerticalBox {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;

                    SectionLabel {
                        text: "Import from Website";
                    }

                    HorizontalBox {
                        spacing: Theme.space-sm;

                        LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: "Paste a product link (e.g. FragranceNet.com)";
                            text <=> root.import_url;
                        }

                        Button {
                            text: "Import";

                            clicked => {
                                if (root.import_url != "") {
                                    root.apply-import(root.import_from_url_requested(root.import_url));
                                }
                            }
                        }
                    }

                    if root.import_error != "" : Text {
                        text: root.import_error;
                        color: #e57373;
                        font-size: 12px;
                    }

                    Text {
                        text: "Fills in Brand, Name, My Notes, Price, and Image where found — double-check before saving.";
                        color: Theme.text-muted;
                        font-size: 12px;
                    }
                }
            }

            SectionCard {
                VerticalBox {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;

                    SectionLabel {
                        text: "Basic Info";
                    }

                    LineEdit {
                        placeholder-text: "Brand";
                        text <=> root.brand;
                    }

                    if root.errors.brand != "" : FieldError {
                        text: root.errors.brand;
                    }

                    LineEdit {
                        placeholder-text: "Name";
                        text <=> root.name;
                    }

                    if root.errors.name != "" : FieldError {
                        text: root.errors.name;
                    }

                    LineEdit {
                        placeholder-text: "Concentration";
                        text <=> root.concentration;
                    }

                    if root.errors.concentration != "" : FieldError {
                        text: root.errors.concentration;
                    }

                    LineEdit {
                        placeholder-text: "Projection";
                        text <=> root.projection;
                    }

                    if root.errors.projection != "" : FieldError {
                        text: root.errors.projection;
                    }

                    LineEdit {
                        placeholder-text: "Longevity";
                        text <=> root.longevity;
                    }

                    if root.errors.longevity != "" : FieldError {
                        text: root.errors.longevity;
                    }

                    LineEdit {
                        placeholder-text: "Price";
                        text <=> root.price;
                    }

                    if root.errors.price != "" : FieldError {
                        text: root.errors.price;
                    }

                    LineEdit {
                        placeholder-text: "Purchase Date (DD-MM-YYYY)";
                        text <=> root.purchase_date;
                    }

                    if root.errors.purchase_date != "" : FieldError {
                        text: root.errors.purchase_date;
                    }
                }
            }

            SectionCard {
                VerticalBox {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;

                    SectionLabel {
                        text: "Ratings";
                    }

                    for entry[i] in root.ratings : VerticalBox {
                        spacing: 3px;

                        HorizontalBox {
                            spacing: Theme.space-sm;

                            Text {
                                text: entry.user_name + ":";
                                color: Theme.text-primary;
                                font-size: 14px;
                                vertical-alignment: center;
                                width: 100px;
                            }

                            LineEdit {
                                width: 55px;
                                text: entry.rating;

                                edited => {
                                    root.ratings[i].rating = max(0.0, min(10.0, self.text.to-float()));
                                }
                            }

                            Text {
                                text: "/ 10";
                                color: Theme.text-secondary;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                        }

                        Slider {
                            minimum: 0;
                            maximum: 10;
                            value: entry.rating;

                            changed(new-value) => {
                                root.ratings[i].rating = round(new-value * 10) / 10;
                            }
                        }
                    }
                }
            }

            SectionCard {
                VerticalBox {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;

                    SectionLabel {
                        text: "Fragrance Notes";
                    }

                    notes-picker := NotesPicker {
                        initial_choices: root.initial_note_choices;

                        note_created(name, choices) => {
                            return root.note_created(name, choices);
                        }

                        search_changed(text, choices) => {
                            return root.search_changed(text, choices);
                        }
                    }

                    if root.errors.notes != "" : FieldError {
                        text: root.errors.notes;
                    }
                }
            }

            SectionCard {
                VerticalBox {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;

                    SectionLabel {
                        text: "Seasons";
                    }

                    HorizontalBox {
                        spacing: Theme.space-sm;

                        CheckBox {
                            text: "Spring";
                            checked <=> root.season_spring;
                        }

                        CheckBox {
                            text: "Summer";
                            checked <=> root.season_summer;
                        }

                        CheckBox {
                            text: "Fall";
                            checked <=> root.season_fall;
                        }

                        CheckBox {
                            text: "Winter";
                            checked <=> root.season_winter;
                        }
                    }
                }
            }

            SectionCard {
                VerticalBox {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;

                    SectionLabel {
                        text: "Category";
                    }

                    HorizontalBox {
                        spacing: Theme.space-sm;

                        CategoryChip {
                            label: "Perfume";
                            selected: root.category == "Perfume";
                            selected_requested => { root.category = "Perfume"; }
                        }

                        CategoryChip {
                            label: "Unisex";
                            selected: root.category == "Unisex";
                            selected_requested => { root.category = "Unisex"; }
                        }

                        CategoryChip {
                            label: "Cologne";
                            selected: root.category == "Cologne";
                            selected_requested => { root.category = "Cologne"; }
                        }
                    }
                }
            }

            SectionCard {
                VerticalBox {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;

                    SectionLabel {
                        text: "Add To";
                    }

                    HorizontalBox {
                        spacing: Theme.space-sm;

                        CategoryChip {
                            label: "Collection";
                            selected: root.list_choice == "Collection";
                            selected_requested => { root.list_choice = "Collection"; }
                        }

                        CategoryChip {
                            label: "Wishlist";
                            selected: root.list_choice == "Wishlist";
                            selected_requested => { root.list_choice = "Wishlist"; }
                        }
                    }
                }
            }

            SectionCard {
                VerticalBox {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;

                    SectionLabel {
                        text: "Personal Notes";
                    }

                    LineEdit {
                        placeholder-text: "My Notes";
                        text <=> root.my_notes;
                    }

                    if root.errors.my_notes != "" : FieldError {
                        text: root.errors.my_notes;
                    }

                    LineEdit {
                        placeholder-text: "Partner Notes";
                        text <=> root.partner_notes;
                    }

                    if root.errors.partner_notes != "" : FieldError {
                        text: root.errors.partner_notes;
                    }
                }
            }

            HorizontalBox {
                spacing: Theme.space-md;

                Button {
                    text: "Add";

                    clicked => {
                        root.errors = root.validate_fragrance(root.build-input());
                        if (!root.errors.has_errors) {
                            root.add_requested(root.build-input());
                        }
                    }
                }

                Button {
                    text: "Cancel";

                    clicked => {
                        root.cancel_requested();
                    }
                }
            }
        }
    }
}