import { VerticalBox, HorizontalBox, Button, LineEdit, SpinBox } from "std-widgets.slint";
import { FragranceData } from "../types.slint";

export component AddFragrance inherits Rectangle {
    callback add_requested(
        string,
        string,
        float,
        string,
        string,
        string,
        string,
        string,
        string,
        string,
        string
    );

    callback cancel_requested();

    property <string> brand;
    property <string> name;
    property <float> rating: 0;
    property <string> concentration;
    property <string> projection;
    property <string> longevity;
    property <string> price;
    property <string> purchase_date;
    property <string> notes;
    property <string> seasons;
    property <string> my_notes;
    property <string> partner_notes;

    background: #181818;

    VerticalBox {
        padding: 30px;
        spacing: 15px;

        Text {
            text: "Add Fragrance";
            font-size: 32px;
            color: white;
        }

        LineEdit {
            placeholder-text: "Brand";
            text <=> root.brand;
        }

        LineEdit {
            placeholder-text: "Name";
            text <=> root.name;
        }

        SpinBox {
            value: root.rating;
            minimum: 0;
            maximum: 10;
        }

        LineEdit {
            placeholder-text: "Concentration";
            text <=> root.concentration;
        }

        LineEdit {
            placeholder-text: "Projection";
            text <=> root.projection;
        }

        LineEdit {
            placeholder-text: "Longevity";
            text <=> root.longevity;
        }

        LineEdit {
            placeholder-text: "Price";
            text <=> root.price;
        }

        LineEdit {
            placeholder-text: "Purchase Date";
            text <=> root.purchase_date;
        }

        LineEdit {
            placeholder-text: "Notes";
            text <=> root.notes;
        }

        LineEdit {
            placeholder-text: "Seasons";
            text <=> root.seasons;
        }

        LineEdit {
            placeholder-text: "My Notes";
            text <=> root.my_notes;
        }

        LineEdit {
            placeholder-text: "Partner Notes";
            text <=> root.partner_notes;
        }

        HorizontalBox {
            spacing: 20px;

            Button {
                text: "Add";

                clicked => {
                    root.add_requested(
                        root.brand,
                        root.name,
                        root.rating,
                        root.concentration,
                        root.projection,
                        root.longevity,
                        root.price,
                        root.purchase_date,
                        root.notes,
                        root.seasons,
                        root.my_notes
                    );
                }
            }

            Button {
                text: "Cancel";

                clicked => {
                    root.cancel_requested();
                }
            }
        }
    }
}