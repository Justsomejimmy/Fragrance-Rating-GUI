import { VerticalBox, HorizontalBox, Button, LineEdit, Slider } from "std-widgets.slint";
import { FragranceData } from "../types.slint";

export component AddFragrance inherits Rectangle {
    callback add_requested(
        string,
        string,
        string,
        string,
        string,
        string,
        string,
        string,
        string,
        string,
        string,
        string,
        string
    );

    callback cancel_requested();
    callback choose_image_requested();

    property <string> brand;
    property <string> name;
    property <float> rating: 5.0;
    property <string> concentration;
    property <string> projection;
    property <string> longevity;
    property <string> price;
    property <string> purchase_date;
    property <string> notes;
    property <string> seasons;
    property <string> my_notes;
    property <string> partner_notes;

    in-out property <string> image_path;

    background: #181818;

    VerticalBox {
        padding: 30px;
        spacing: 15px;

        Text {
            text: "Add Fragrance";
            font-size: 32px;
            color: white;
        }

        HorizontalBox {
            spacing: 10px;

            Button {
                text: "Choose Image";

                clicked => {
                    root.choose_image_requested();
                }
            }

            Text {
                text: root.image_path == "" ? "No image selected" : root.image_path;
                color: #aaaaaa;
                vertical-alignment: center;
            }
        }

        LineEdit {
            placeholder-text: "Brand";
            text <=> root.brand;
        }

        LineEdit {
            placeholder-text: "Name";
            text <=> root.name;
        }

        VerticalBox {
            spacing: 5px;

            HorizontalBox {
                spacing: 10px;

                Text {
                    text: "Rating:";
                    color: white;
                    font-size: 16px;
                    vertical-alignment: center;
                }

                LineEdit {
                    width: 60px;
                    text: root.rating;

                    edited => {
                        root.rating = max(0.0, min(10.0, self.text.to-float()));
                    }
                }

                Text {
                    text: "/ 10";
                    color: white;
                    font-size: 16px;
                    vertical-alignment: center;
                }
            }

            Slider {
                minimum: 0;
                maximum: 10;
                value: root.rating;

                changed(new-value) => {
                    root.rating = round(new-value * 10) / 10;
                }
            }
        }

        LineEdit {
            placeholder-text: "Concentration";
            text <=> root.concentration;
        }

        LineEdit {
            placeholder-text: "Projection";
            text <=> root.projection;
        }

        LineEdit {
            placeholder-text: "Longevity";
            text <=> root.longevity;
        }

        LineEdit {
            placeholder-text: "Price";
            text <=> root.price;
        }

        LineEdit {
            placeholder-text: "Purchase Date";
            text <=> root.purchase_date;
        }

        LineEdit {
            placeholder-text: "Notes";
            text <=> root.notes;
        }

        LineEdit {
            placeholder-text: "Seasons";
            text <=> root.seasons;
        }

        LineEdit {
            placeholder-text: "My Notes";
            text <=> root.my_notes;
        }

        LineEdit {
            placeholder-text: "Partner Notes";
            text <=> root.partner_notes;
        }

        HorizontalBox {
            spacing: 20px;

            Button {
                text: "Add";

                clicked => {
                    root.add_requested(
                        root.brand,
                        root.name,
                        "" + root.rating,
                        root.concentration,
                        root.projection,
                        root.longevity,
                        root.price,
                        root.purchase_date,
                        root.notes,
                        root.seasons,
                        root.my_notes,
                        root.partner_notes,
                        root.image_path
                    );
                }
            }

            Button {
                text: "Cancel";

                clicked => {
                    root.cancel_requested();
                }
            }
        }
    }
}