import { VerticalBox, HorizontalBox, Button, LineEdit, ScrollView } from "std-widgets.slint";
import { AppUser } from "../types.slint";
import { Theme } from "../theme.slint";

component SectionCard inherits Rectangle {
    background: Theme.bg-card;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;
}

component SectionLabel inherits Text {
    color: Theme.text-primary;
    font-size: 16px;
    font-weight: 700;
}

export component SettingsPage inherits Rectangle {
    in property <[AppUser]> users;

    callback add_user_requested(string);
    callback update_user_requested(int, string);
    callback delete_user_requested(int);

    property <string> new_user_name;

    background: Theme.bg-app;

    VerticalBox {
        padding: Theme.space-lg;
        spacing: Theme.space-lg;

        VerticalBox {
            spacing: 2px;

            Text {
                text: "Settings";
                font-size: Theme.title-size;
                font-weight: 800;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }

            Text {
                text: "Manage the people rating your fragrances";
                font-size: Theme.subtitle-size;
                font-weight: 500;
                color: Theme.text-secondary;
                horizontal-alignment: center;
            }
        }

        SectionCard {
            VerticalBox {
                padding: Theme.space-md;
                spacing: Theme.space-sm;

                SectionLabel {
                    text: "Users";
                }

                Text {
                    text: "Press Enter after editing a name to save it.";
                    color: Theme.text-muted;
                    font-size: 12px;
                }

                ScrollView {
                    height: 260px;

                    VerticalBox {
                        spacing: Theme.space-sm;

                        for user in root.users : HorizontalBox {
                            spacing: Theme.space-sm;

                            LineEdit {
                                text: user.name;
                                horizontal-stretch: 1;

                                accepted(new-name) => {
                                    root.update_user_requested(user.id, new-name);
                                }
                            }

                            Button {
                                text: "Remove";

                                clicked => {
                                    root.delete_user_requested(user.id);
                                }
                            }
                        }
                    }
                }

                HorizontalBox {
                    spacing: Theme.space-sm;

                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "New user name";
                        text <=> root.new_user_name;
                    }

                    Button {
                        text: "Add User";

                        clicked => {
                            if (root.new_user_name != "") {
                                root.add_user_requested(root.new_user_name);
                                root.new_user_name = "";
                            }
                        }
                    }
                }
            }
        }
    }
}