import { VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { FragranceCard } from "../components/fragrance_card.slint";
import { FragranceData, DashboardData } from "../types.slint";

export component Dashboard inherits Rectangle {
    in property <DashboardData> dashboard;

    callback fragrance_clicked(FragranceData);

    background: #181818;

    ScrollView {
        VerticalBox {
            padding: 30px;
            spacing: 25px;

            Text {
                text: "Dashboard";
                font-size: 40px;
                color: white;
            }

            if root.dashboard.total == 0 : Text {
                text: "No fragrances in your collection yet.";
                color: #aaaaaa;
                font-size: 18px;
            }

            if root.dashboard.total > 0 : VerticalBox {
                spacing: 25px;

                HorizontalBox {
                    spacing: 20px;

                    Rectangle {
                        background: #242424;
                        border-radius: 12px;
                        height: 100px;
                        horizontal-stretch: 1;

                        VerticalBox {
                            padding: 15px;
                            alignment: center;

                            Text {
                                text: root.dashboard.total;
                                color: white;
                                font-size: 32px;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Total Fragrances";
                                color: #aaaaaa;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        background: #242424;
                        border-radius: 12px;
                        height: 100px;
                        horizontal-stretch: 1;

                        VerticalBox {
                            padding: 15px;
                            alignment: center;

                            Text {
                                text: "⭐ " + root.dashboard.average_rating;
                                color: white;
                                font-size: 32px;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Average Rating";
                                color: #aaaaaa;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        background: #242424;
                        border-radius: 12px;
                        height: 100px;
                        horizontal-stretch: 1;

                        VerticalBox {
                            padding: 15px;
                            alignment: center;

                            Text {
                                text: root.dashboard.highest_rated.brand + " " + root.dashboard.highest_rated.name;
                                color: white;
                                font-size: 16px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "Highest Rated — ⭐ " + root.dashboard.highest_rated.rating;
                                color: #aaaaaa;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        background: #242424;
                        border-radius: 12px;
                        height: 100px;
                        horizontal-stretch: 1;

                        VerticalBox {
                            padding: 15px;
                            alignment: center;

                            Text {
                                text: root.dashboard.lowest_rated.brand + " " + root.dashboard.lowest_rated.name;
                                color: white;
                                font-size: 16px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "Lowest Rated — ⭐ " + root.dashboard.lowest_rated.rating;
                                color: #aaaaaa;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                VerticalBox {
                    spacing: 10px;

                    Text {
                        text: "Top Fragrances This Season (" + root.dashboard.most_common_season + ")";
                        color: white;
                        font-size: 22px;
                    }

                    HorizontalBox {
                        spacing: 20px;

                        for fragrance in root.dashboard.season_top : FragranceCard {
                            brand: fragrance.brand;
                            name: fragrance.name;
                            rating: fragrance.rating;
                            notes: fragrance.notes;
                            seasons: fragrance.seasons;
                            category: fragrance.category;
                            fragrance-image: fragrance.image;
                            image_offset_x: fragrance.image_offset_x;
                            image_offset_y: fragrance.image_offset_y;
                            image_scale: fragrance.image_scale;

                            card_clicked => {
                                root.fragrance_clicked(fragrance);
                            }
                        }
                    }
                }

                VerticalBox {
                    spacing: 10px;

                    Text {
                        text: "Recently Added";
                        color: white;
                        font-size: 22px;
                    }

                    HorizontalBox {
                        spacing: 20px;

                        for fragrance in root.dashboard.recently_added : FragranceCard {
                            brand: fragrance.brand;
                            name: fragrance.name;
                            rating: fragrance.rating;
                            notes: fragrance.notes;
                            seasons: fragrance.seasons;
                            category: fragrance.category;
                            fragrance-image: fragrance.image;
                            image_offset_x: fragrance.image_offset_x;
                            image_offset_y: fragrance.image_offset_y;
                            image_scale: fragrance.image_scale;

                            card_clicked => {
                                root.fragrance_clicked(fragrance);
                            }
                        }
                    }
                }

                VerticalBox {
                    spacing: 10px;

                    Text {
                        text: "Top Colognes";
                        color: white;
                        font-size: 22px;
                    }

                    HorizontalBox {
                        spacing: 20px;

                        for fragrance in root.dashboard.top_cologne : FragranceCard {
                            brand: fragrance.brand;
                            name: fragrance.name;
                            rating: fragrance.rating;
                            notes: fragrance.notes;
                            seasons: fragrance.seasons;
                            category: fragrance.category;
                            fragrance-image: fragrance.image;
                            image_offset_x: fragrance.image_offset_x;
                            image_offset_y: fragrance.image_offset_y;
                            image_scale: fragrance.image_scale;

                            card_clicked => {
                                root.fragrance_clicked(fragrance);
                            }
                        }
                    }
                }

                VerticalBox {
                    spacing: 10px;

                    Text {
                        text: "Top Perfumes";
                        color: white;
                        font-size: 22px;
                    }

                    HorizontalBox {
                        spacing: 20px;

                        for fragrance in root.dashboard.top_perfume : FragranceCard {
                            brand: fragrance.brand;
                            name: fragrance.name;
                            rating: fragrance.rating;
                            notes: fragrance.notes;
                            seasons: fragrance.seasons;
                            category: fragrance.category;
                            fragrance-image: fragrance.image;
                            image_offset_x: fragrance.image_offset_x;
                            image_offset_y: fragrance.image_offset_y;
                            image_scale: fragrance.image_scale;

                            card_clicked => {
                                root.fragrance_clicked(fragrance);
                            }
                        }
                    }
                }
            }
        }
    }
}