import { VerticalBox, HorizontalBox, ScrollView, ComboBox } from "std-widgets.slint";
import { RankingItem } from "../types.slint";
import { Theme } from "../theme.slint";

export component RankingsPage inherits Rectangle {
    in property <[RankingItem]> ranking_items;
    in property <[string]> user_names;

    callback rank_requested(string, string);

    property <string> mode: "Overall";
    property <string> season_option: "Spring";
    property <string> category_option: "Perfume";
    property <string> user_option: "";

    property <length> bar_max_width: 280px;

    background: Theme.bg-app;

    VerticalBox {
        padding: Theme.space-lg;
        spacing: Theme.space-lg;

        VerticalBox {
            spacing: 2px;

            Text {
                text: "Rankings";
                font-size: 34px;
                font-weight: 800;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }

            Text {
                text: "Your top 10 fragrances";
                font-size: 14px;
                font-weight: 500;
                color: Theme.text-secondary;
                horizontal-alignment: center;
            }
        }

        Rectangle {
            background: Theme.bg-card;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            height: 70px;

            HorizontalBox {
                padding: Theme.space-sm;
                spacing: Theme.space-sm;

                ComboBox {
                    width: 180px;
                    model: ["Overall", "Season", "Category", "Rating by User"];
                    current-value <=> root.mode;

                    selected => {
                        if (root.mode == "Overall") {
                            root.rank_requested("Overall", "");
                        } else if (root.mode == "Season") {
                            root.rank_requested("Season", root.season_option);
                        } else if (root.mode == "Category") {
                            root.rank_requested("Category", root.category_option);
                        } else if (root.mode == "Rating by User") {
                            if (root.user_names.length > 0) {
                                root.user_option = root.user_names[0];
                                root.rank_requested("User", root.user_option);
                            }
                        }
                    }
                }

                if root.mode == "Season" : ComboBox {
                    width: 160px;
                    model: ["Spring", "Summer", "Fall", "Winter"];
                    current-value <=> root.season_option;

                    selected => {
                        root.rank_requested("Season", root.season_option);
                    }
                }

                if root.mode == "Category" : ComboBox {
                    width: 160px;
                    model: ["Perfume", "Unisex", "Cologne"];
                    current-value <=> root.category_option;

                    selected => {
                        root.rank_requested("Category", root.category_option);
                    }
                }

                if root.mode == "Rating by User" : ComboBox {
                    width: 160px;
                    model: root.user_names;
                    current-value <=> root.user_option;

                    selected => {
                        root.rank_requested("User", root.user_option);
                    }
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalBox {
                spacing: Theme.space-sm;

                for item[i] in root.ranking_items : Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border;
                    height: 76px;

                    HorizontalBox {
                        padding: Theme.space-sm;
                        spacing: Theme.space-sm;

                        Text {
                            text: (i + 1) + ".";
                            color: Theme.text-secondary;
                            font-size: 18px;
                            font-weight: 700;
                            width: 32px;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 56px;
                            height: 56px;
                            clip: true;
                            border-radius: Theme.radius-sm;
                            background: #000000;

                            Image {
                                source: item.image;
                                width: 56px * item.image_scale;
                                height: 56px * item.image_scale;
                                x: (56px - self.width) / 2 + item.image_offset_x * 1px;
                                y: (56px - self.height) / 2 + item.image_offset_y * 1px;
                                image-fit: cover;
                            }
                        }

                        VerticalBox {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: item.brand;
                                color: Theme.text-secondary;
                                font-size: 12px;
                            }

                            Text {
                                text: item.name;
                                color: Theme.text-primary;
                                font-size: 16px;
                                font-weight: 700;
                                wrap: word-wrap;
                                overflow: elide;
                            }
                        }

                        Rectangle {
                            width: root.bar_max_width;
                            height: 18px;
                            background: Theme.bg-card-alt;
                            border-radius: 9px;
                            clip: true;

                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: root.bar_max_width * (item.display_rating / 10);
                                height: 18px;
                                background: Theme.accent;
                                border-radius: 9px;
                            }
                        }

                        Text {
                            text: item.display_rating;
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                            width: 40px;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.ranking_items.length == 0 : Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-lg;
                    border-width: 1px;
                    border-color: Theme.border;
                    height: 100px;

                    Text {
                        text: "No fragrances to rank yet.";
                        color: Theme.text-secondary;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}