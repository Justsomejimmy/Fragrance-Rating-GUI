export global Theme {
    out property <color> bg-app: #1c1f26;
    out property <color> bg-sidebar: #21242b;
    out property <color> bg-card: #292c34;
    out property <color> bg-card-alt: #2f323b;
    out property <color> border: #383b44;
    out property <color> accent: #7c9eff;
    out property <color> accent-soft: #7c9eff26;
    out property <color> text-primary: #edeef2;
    out property <color> text-secondary: #9a9ea8;
    out property <color> text-muted: #6f7280;

    out property <length> radius-sm: 8px;
    out property <length> radius-md: 12px;
    out property <length> radius-lg: 18px;

    in-out property <float> scale: 1.0;

    out property <length> space-xs: 6px * root.scale;
    out property <length> space-sm: 12px * root.scale;
    out property <length> space-md: 20px * root.scale;
    out property <length> space-lg: 30px * root.scale;

    out property <length> title-size: 34px * root.scale;
    out property <length> subtitle-size: 14px * root.scale;
}